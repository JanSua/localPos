# Copy to .env and edit — never edit docker-compose.yml itself.
# `docker compose` reads a .env file in this directory automatically, so
# these three variables are the only thing that differs between an offline
# LAN box and a public VPS deploy.

# --- Local machine / shop LAN (default — this is what install.sh assumes) ---
# HOST_PORT=1994
# FRONTEND_ORIGIN=http://localhost:1994
# COOKIE_SECURE=false

# Database settings. `local` starts the bundled PostgreSQL container
# (default, suited to Windows development). Set `external` on the VPS to use
# PostgreSQL already attached to POSTGRES_NETWORK.
POSTGRES_MODE=local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nodedrpos
POSTGRES_USER=nodedr
# Local installers generate a strong alphanumeric password if blank. For
# external mode, set this to the dedicated password you created.
POSTGRES_PASSWORD=
POSTGRES_NETWORK=nodedr-pos-postgres
# Optional host-only port for connecting local administration tools to the
# bundled database; PostgreSQL still listens on 5432 in the container.
POSTGRES_LOCAL_PORT=15432

# --- VPS / publicly reachable host using the existing PostgreSQL container ---
# POSTGRES_MODE=external
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=nodedrpos
# POSTGRES_USER=nodedrpos
# POSTGRES_PASSWORD=use-the-password-created-in-postgresql
# POSTGRES_NETWORK=postgres_backend
#
# The backend joins that existing Docker network; PostgreSQL itself is never
# published by this app's Compose file.
# Put a reverse proxy with real HTTPS (Caddy/Nginx + Let's Encrypt) in front,
# then set:
# HOST_PORT=1994
# FRONTEND_ORIGIN=https://pos.yourdomain.com
# COOKIE_SECURE=true

# --- Optional LAN HTTPS front door, for camera scanning on phones/tablets ---
# See README > Camera scanning over HTTPS. Only takes effect when you run
# `docker compose --profile https up -d` — a plain `docker compose up` never
# starts it, so this is safe to leave commented out otherwise.
# HTTPS_PORT=443

# --- Optional Cloudflare Tunnel, an alternative to the above with a real
# trusted certificate and access from anywhere, not just your LAN ---
# See README > Camera scanning over HTTPS > Cloudflare Tunnel. Only needed
# for `docker compose --profile cloudflare up -d` (the named-tunnel mode —
# `--profile cloudflare-quick` needs no token at all). Paste the token from
# your tunnel's page under Cloudflare Zero Trust > Networks > Tunnels.
# CLOUDFLARE_TUNNEL_TOKEN=

HOST_PORT=1994
FRONTEND_ORIGIN=http://localhost:1994
COOKIE_SECURE=false
