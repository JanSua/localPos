# Copy to .env for local (non-Docker) development. Use the password from
# the repository-root .env file created by install.ps1/install.sh.
DATABASE_URL="postgresql://nodedr:<POSTGRES_PASSWORD>@localhost:15432/nodedrpos?schema=public"
PORT=4000
FRONTEND_ORIGIN="http://localhost:1994"

# Optional: pin a JWT signing secret. If unset, one is auto-generated on
# first boot and persisted to data/.jwt-secret so sessions survive restarts.
# JWT_SECRET=

# Set to "true" only if the app is served over HTTPS.
COOKIE_SECURE=false
