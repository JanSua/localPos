# Copy to .env for local (non-Docker) development. Local PostgreSQL's host
# port defaults to 15432; use the corresponding credentials from the root
# .env file.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=nodedrpos
POSTGRES_USER=nodedr
POSTGRES_PASSWORD=
PORT=4000
FRONTEND_ORIGIN="http://localhost:1994"

# Optional: pin a JWT signing secret. If unset, one is auto-generated on
# first boot and persisted to data/.jwt-secret so sessions survive restarts.
# JWT_SECRET=

# Set to "true" only if the app is served over HTTPS.
COOKIE_SECURE=false
